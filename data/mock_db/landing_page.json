    "site_id": "6a1997aa0a27d49ea4853fe7",
    "html_content": "<!DOCTYPE html>\n<html lang=\"en-IN\">\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n    <title>Apple (India) – Redesigned</title>\n    <!-- Bootstrap 5.2 CSS -->\n    <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css\" rel=\"stylesheet\" integrity=\"sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65\" crossorigin=\"anonymous\">\n    <!-- Modern font: Inter + system-ui -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,600;14..32,700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body {\n            font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;\n            background-color: #f9fafb;\n            color: #1d1d1f;\n            line-height: 1.6;\n        }\n        h1, h2, h3, h4, h5, h6 {\n            font-weight: 600;\n            letter-spacing: -0.02em;\n        }\n        .headline-xl {\n            font-size: 3.2rem;\n            font-weight: 700;\n            letter-spacing: -0.03em;\n            line-height: 1.1;\n        }\n        .headline-lg {\n            font-size: 2.4rem;\n            font-weight: 600;\n            letter-spacing: -0.02em;\n        }\n        .headline-md {\n            font-size: 1.75rem;\n            font-weight: 600;\n        }\n        .subhead-custom {\n            font-size: 1.2rem;\n            font-weight: 400;\n            color: #6c6c70;\n        }\n        .bg-soft-black {\n            background-color: #1d1d1f;\n        }\n        .bg-soft-gray {\n            background-color: #f5f5f7;\n        }\n        .text-apple-dark {\n            color: #1d1d1f;\n        }\n        .text-apple-light {\n            color: #f5f5f7;\n        }\n        .card {\n            border: none;\n            border-radius: 2rem;\n            transition: transform 0.25s ease, box-shadow 0.3s ease;\n            background: white;\n        }\n        .card:hover {\n            transform: translateY(-6px);\n            box-shadow: 0 20px 35px -8px rgba(0,0,0,0.1);\n        }\n        .card-dark {\n            background: #1d1d1f;\n            color: #f5f5f7;\n        }\n        .card-dark .subhead-custom {\n            color: #a1a1a6;\n        }\n        .btn-apple-primary {\n            background-color: #0071e3;\n            border: none;\n            border-radius: 40px;\n            padding: 12px 28px;\n            font-weight: 500;\n            font-size: 1rem;\n            color: white;\n            transition: all 0.2s;\n        }\n        .btn-apple-primary:hover {\n            background-color: #0077ed;\n            transform: scale(1.02);\n            color: white;\n        }\n        .btn-apple-secondary {\n            background-color: transparent;\n            border: 1px solid #1d1d1f;\n            border-radius: 40px;\n            padding: 12px 28px;\n            font-weight: 500;\n            color: #1d1d1f;\n            transition: all 0.2s;\n        }\n        .btn-apple-secondary:hover {\n            background-color: #1d1d1f;\n            color: white;\n        }\n        .btn-apple-dark {\n            background-color: white;\n            color: #1d1d1f;\n            border-radius: 40px;\n            padding: 12px 28px;\n            font-weight: 500;\n            border: none;\n        }\n        .btn-apple-dark:hover {\n            background-color: #e8e8ed;\n            color: #1d1d1f;\n        }\n        .section-padding {\n            padding: 5rem 0;\n        }\n        .shadow-soft {\n            box-shadow: 0 12px 30px -8px rgba(0,0,0,0.08);\n        }\n        .rounded-4 {\n            border-radius: 2rem !important;\n        }\n        .footer-link {\n            color: #6c6c70;\n            text-decoration: none;\n            font-size: 0.9rem;\n        }\n        .footer-link:hover {\n            color: #1d1d1f;\n            text-decoration: underline;\n        }\n        .gradient-ribbon {\n            background: linear-gradient(145deg, #f9fafb, #ffffff);\n            border-bottom: 1px solid rgba(0,0,0,0.03);\n        }\n        .img-wrapper {\n            overflow: hidden;\n            border-radius: 2rem;\n            max-height: 380px;\n        }\n        .img-wrapper img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n        }\n        .tv-card {\n            background: #000;\n            border-radius: 2rem;\n            overflow: hidden;\n            min-height: 320px;\n            color: white;\n        }\n        .tv-card .card-body {\n            padding: 2rem;\n        }\n        .tv-card .subhead-custom {\n            color: #a1a1a6;\n        }\n        .footer-top {\n            border-top: 1px solid #e8e8ed;\n        }\n        @media (max-width: 768px) {\n            .headline-xl {\n                font-size: 2.2rem;\n            }\n            .headline-lg {\n                font-size: 1.8rem;\n            }\n            .section-padding {\n                padding: 3rem 0;\n            }\n        }\n        /* preserve original images (via background or inline) — we use inline images from source */\n        .unit-image {\n            background-size: cover;\n            background-position: center;\n            width: 100%;\n            height: 100%;\n            min-height: 220px;\n            border-radius: 1.5rem;\n        }\n        .unit-image-mac-for-students-hero-mac-for-students {\n            background-image: url('https://www.apple.com/in/home/heroes/mac-for-students/images/hero_mac_for_students.jpg'); /* fallback, but original uses figure classes */\n        }\n        /* we keep original figure background via classes, but we'll use inline style to be safe */\n        .bg-mac-student {\n            background: url('https://www.apple.com/in/home/heroes/mac-for-students/images/hero_mac_for_students.jpg') center/cover no-repeat;\n        }\n        .bg-iphone-family {\n            background: url('https://www.apple.com/in/home/heroes/iphone-family/images/hero_iphone_family.jpg') center/cover no-repeat;\n        }\n        .bg-macbook-air {\n            background: url('https://www.apple.com/in/home/heroes/macbook-air-m5/images/hero_macbook_air_m5.jpg') center/cover no-repeat;\n        }\n        .bg-wwdc {\n            background: url('https://www.apple.com/in/home/promos/wwdc26-announce/images/promo_wwdc26_announce.jpg') center/cover no-repeat;\n        }\n        .bg-watch {\n            background: url('https://www.apple.com/in/home/promos/apple-watch-series-11/images/promo_apple_watch_series_11.jpg') center/cover no-repeat;\n        }\n        .bg-macbook-pro {\n            background: url('https://www.apple.com/in/home/promos/macbook-pro/images/promo_macbook_pro.jpg') center/cover no-repeat;\n        }\n        .bg-airpods {\n            background: url('https://www.apple.com/in/home/promos/airpods-pro-3/images/promo_airpods_pro_3.jpg') center/cover no-repeat;\n        }\n        .bg-ipad-pro {\n            background: url('https://www.apple.com/in/home/promos/ipad-pro/images/promo_ipad_pro.jpg') center/cover no-repeat;\n        }\n        .bg-tradein {\n            background: url('https://www.apple.com/in/home/promos/iphone-tradein/images/promo_iphone_tradein.jpg') center/cover no-repeat;\n        }\n        .hero-card {\n            border-radius: 2.5rem;\n            overflow: hidden;\n            min-height: 420px;\n        }\n        .hero-card .card-body {\n            padding: 2.5rem;\n        }\n        .tv-gallery-bg {\n            background: #000;\n            border-radius: 2.5rem;\n            padding: 2rem;\n        }\n    </style>\n</head>\n<body>\n\n<!-- Ribbon / offer bar -->\n<section class=\"gradient-ribbon py-3\">\n    <div class=\"container text-center small fw-medium\">\n        Get up to 6 months of No Cost EMI<sup>*</sup> plus up to ₹10000 instant cashback<sup>‡</sup> on selected products with eligible cards. <a href=\"https://www.apple.com/in/shop/goto/store\" class=\"text-decoration-none fw-semibold\">Shop <span>&#8594;</span></a>\n    </div>\n</section>\n\n<!-- Main hero area: 3 heroes in a grid -->\n<section class=\"section-padding pt-4\">\n    <div class=\"container\">\n        <div class=\"row g-4\">\n            <!-- Hero 1: Mac for students (dark) -->\n            <div class=\"col-12 col-lg-4\">\n                <div class=\"card card-dark hero-card h-100 p-0\">\n                    <div class=\"card-body d-flex flex-column justify-content-end bg-mac-student\" style=\"min-height: 420px; background-blend-mode: overlay; background-color: rgba(0,0,0,0.3);\">\n                        <h2 class=\"headline-lg text-white\">Mac for students</h2>\n                        <p class=\"subhead-custom text-white-50\">No matter what you do, ace it with Mac.</p>\n                        <a href=\"https://www.apple.com/in/education/mac/\" class=\"btn btn-apple-dark align-self-start mt-2\">Learn more</a>\n                    </div>\n                </div>\n            </div>\n            <!-- Hero 2: iPhone family -->\n            <div class=\"col-12 col-lg-4\">\n                <div class=\"card hero-card h-100 p-0\">\n                    <div class=\"card-body d-flex flex-column justify-content-end bg-iphone-family\" style=\"min-height: 420px;\">\n                        <h2 class=\"headline-lg\">iPhone</h2>\n                        <p class=\"subhead-custom\">Meet the latest iPhone line-up.</p>\n                        <div class=\"d-flex gap-2 mt-2\">\n                            <a href=\"https://www.apple.com/in/iphone/\" class=\"btn btn-apple-primary\">Learn more</a>\n                            <a href=\"https://www.apple.com/in/shop/goto/buy_iphone\" class=\"btn btn-apple-secondary\">Shop</a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <!-- Hero 3: MacBook Air M5 -->\n            <div class=\"col-12 col-lg-4\">\n                <div class=\"card hero-card h-100 p-0\">\n                    <div class=\"card-body d-flex flex-column justify-content-end bg-macbook-air\" style=\"min-height: 420px;\">\n                        <h2 class=\"headline-lg\">MacBook Air</h2>\n                        <p class=\"subhead-custom\">Now supercharged by M5.</p>\n                        <div class=\"d-flex gap-2 mt-2\">\n                            <a href=\"https://www.apple.com/in/macbook-air/\" class=\"btn btn-apple-primary\">Learn more</a>\n                            <a href=\"https://www.apple.com/in/shop/goto/buy_mac/macbook_air\" class=\"btn btn-apple-secondary\">Buy</a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n\n<!-- Promo grid: 6 cards with original images -->\n<section class=\"section-padding pt-0\">\n    <div class=\"container\">\n        <div class=\"row g-4\">\n            <!-- 1. WWDC -->\n            <div class=\"col-md-6 col-lg-4\">\n                <div class=\"card h-100 p-3 p-md-4 shadow-soft\">\n                    <div class=\"img-wrapper mb-3 bg-wwdc\" style=\"height: 200px;\"></div>\n                    <h3 class=\"headline-md\">WWDC26</h3>\n                    <p class=\"subhead-custom\">Apple Worldwide Developers Conference. Join us online on 8–12 June.</p>\n                    <a href=\"https://developer.apple.com/wwdc26/\" class=\"btn btn-apple-primary mt-auto align-self-start\">Learn more</a>\n                </div>\n            </div>\n            <!-- 2. Apple Watch Series 11 -->\n            <div class=\"col-md-6 col-lg-4\">\n                <div class=\"card h-100 p-3 p-md-4 shadow-soft\">\n                    <div class=\"img-wrapper mb-3 bg-watch\" style=\"height: 200px;\"></div>\n                    <h3 class=\"headline-md\">Apple Watch Series 11</h3>\n                    <p class=\"subhead-custom\">The ultimate watch for a healthy life.</p>\n                    <div class=\"d-flex gap-2 mt-2\">\n                        <a href=\"https://www.apple.com/in/apple-watch-series-11/\" class=\"btn btn-apple-primary\">Learn more</a>\n                        <a href=\"https://www.apple.com/in/shop/goto/buy_watch/apple_watch_series_11\" class=\"btn btn-apple-secondary\">Buy</a>\n                    </div>\n                </div>\n            </div>\n            <!-- 3. MacBook Pro -->\n            <div class=\"col-md-6 col-lg-4\">\n                <div class=\"card h-100 p-3 p-md-4 shadow-soft\">\n                    <div class=\"img-wrapper mb-3 bg-macbook-pro\" style=\"height: 200px;\"></div>\n                    <h3 class=\"headline-md\">MacBook Pro</h3>\n                    <p class=\"subhead-custom\">Now with M5, M5 Pro and M5 Max.</p>\n                    <div class=\"d-flex gap-2 mt-2\">\n                        <a href=\"https://www.apple.com/in/macbook-pro/\" class=\"btn btn-apple-primary\">Learn more</a>\n                        <a href=\"https://www.apple.com/in/shop/goto/buy_mac/macbook_pro\" class=\"btn btn-apple-secondary\">Buy</a>\n                    </div>\n                </div>\n            </div>\n            <!-- 4. AirPods Pro 3 -->\n            <div class=\"col-md-6 col-lg-4\">\n                <div class=\"card h-100 p-3 p-md-4 shadow-soft\">\n                    <div class=\"img-wrapper mb-3 bg-airpods\" style=\"height: 200px;\"></div>\n                    <h3 class=\"headline-md\">AirPods Pro 3</h3>\n                    <p class=\"subhead-custom\">The world’s best in-ear Active Noise Cancellation.<sup>1</sup></p>\n                    <div class=\"d-flex gap-2 mt-2\">\n                        <a href=\"https://www.apple.com/in/airpods-pro/\" class=\"btn btn-apple-primary\">Learn more</a>\n                        <a href=\"https://www.apple.com/in/shop/goto/buy_airpods/airpods_pro_3\" class=\"btn btn-apple-secondary\">Buy</a>\n                    </div>\n                </div>\n            </div>\n            <!-- 5. iPad Pro -->\n            <div class=\"col-md-6 col-lg-4\">\n                <div class=\"card card-dark h-100 p-3 p-md-4 shadow-soft\">\n                    <div class=\"img-wrapper mb-3 bg-ipad-pro\" style=\"height: 200px;\"></div>\n                    <h3 class=\"headline-md text-white\">iPad Pro</h3>\n                    <p class=\"subhead-custom text-white-50\">Advanced AI performance and game-changing capabilities.</p>\n                    <div class=\"d-flex gap-2 mt-2\">\n                        <a href=\"https://www.apple.com/in/ipad-pro/\" class=\"btn btn-apple-dark\">Learn more</a>\n                        <a href=\"https://www.apple.com/in/shop/goto/ipad_pro/select\" class=\"btn btn-apple-secondary text-white border-white\">Buy</a>\n                    </div>\n                </div>\n            </div>\n            <!-- 6. Apple Trade In -->\n            <div class=\"col-md-6 col-lg-4\">\n                <div class=\"card h-100 p-3 p-md-4 shadow-soft\">\n                    <div class=\"img-wrapper mb-3 bg-tradein\" style=\"height: 200px;\"></div>\n                    <h3 class=\"headline-md\">Apple Trade In</h3>\n                    <p class=\"subhead-custom\">Upgrade and save. It’s that easy.</p>\n                    <a href=\"https://www.apple.com/in/shop/goto/trade_in\" class=\"btn btn-apple-primary mt-auto align-self-start\">Get your estimate</a>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n\n<!-- Apple TV+ Gallery Section (preserved content) -->\n<section class=\"section-padding pt-0\">\n    <div class=\"container\">\n        <div class=\"tv-gallery-bg\">\n            <h4 class=\"text-white mb-3 fw-light\" style=\"letter-spacing: 2px;\">APPLE TV+</h4>\n            <div class=\"row g-3\">\n                <!-- we replicate the gallery items from original data using images from source -->\n                <div class=\"col-6 col-md-4 col-lg-3\">\n                    <div class=\"card bg-transparent border-0 text-white\">\n                        <img src=\"https://is1-ssl.mzstatic.com/image/thumb/ubyMKBPSumJZe4z6Nn1A2A/{w}x{h}.{f}\" alt=\"Monarch\" class=\"img-fluid rounded-4\" style=\"width:100%; aspect-ratio: 16/9; object-fit: cover;\">\n                        <p class=\"mt-2 small fw-semibold\">Monarch: Legacy of Monsters</p>\n                        <span class=\"small text-white-50\">A monstrous adventure series.</span>\n                    </div>\n                </div>\n                <div class=\"col-6 col-md-4 col-lg-3\">\n                    <div class=\"card bg-transparent border-0 text-white\">\n                        <img src=\"https://is1-ssl.mzstatic.com/image/thumb/5Qz4uhl7ZfeRONLyHtOGfw/{w}x{h}.{f}\" alt=\"The Studio\" class=\"img-fluid rounded-4\" style=\"width:100%; aspect-ratio: 16/9; object-fit: cover;\">\n                        <p class=\"mt-2 small fw-semibold\">The Studio</p>\n                        <span class=\"small text-white-50\">13 Wins—Most Awarded Comedy</span>\n                    </div>\n                </div>\n                <div class=\"col-6 col-md-4 col-lg-3\">\n                    <div class=\"card bg-transparent border-0 text-white\">\n                        <img src=\"https://is1-ssl.mzstatic.com/image/thumb/zLbkVwwHwe8I5EtuXc8wWg/{w}x{h}.{f}\" alt=\"F1\" class=\"img-fluid rounded-4\" style=\"width:100%; aspect-ratio: 16/9; object-fit: cover;\">\n                        <p class=\"mt-2 small fw-semibold\">F1 The Movie</p>\n                        <span class=\"small text-white-50\">Brad Pitt is a racing legend</span>\n                    </div>\n                </div>\n                <div class=\"col-6 col-md-4 col-lg-3\">\n                    <div class=\"card bg-transparent border-0 text-white\">\n                        <img src=\"https://is1-ssl.mzstatic.com/image/thumb/DECsbtpVyiT0zpSeop88gg/{w}x{h}.{f}\" alt=\"Your Friends\" class=\"img-fluid rounded-4\" style=\"width:100%; aspect-ratio: 16/9; object-fit: cover;\">\n                        <p class=\"mt-2 small fw-semibold\">Your Friends & Neighbours</p>\n                        <span class=\"small text-white-50\">A desperate man will do anything</span>\n                    </div>\n                </div>\n                <!-- add more to match original count, using original URLs -->\n                <div class=\"col-6 col-md-4 col-lg-3\">\n                    <div class=\"card bg-transparent border-0 text-white\">\n                        <img src=\"https://is1-ssl.mzstatic.com/image/thumb/EvRDcABkXaaZtPZhuzqbkA/{w}x{h}.{f}\" alt=\"Morning Show\" class=\"img-fluid rounded-4\" style=\"width:100%; aspect-ratio: 16/9; object-fit: cover;\">\n                        <p class=\"mt-2 small fw-semibold\">The Morning Show</p>\n                        <span class=\"small text-white-50\">Scandals, affairs, conspiracies</span>\n                    </div>\n                </div>\n                <div class=\"col-6 col-md-4 col-lg-3\">\n                    <div class=\"card bg-transparent border-0 text-white\">\n                        <img src=\"https://is1-ssl.mzstatic.com/image/thumb/S9dLxU_nCvhomqGnI3-d_g/{w}x{h}.{f}\" alt=\"Pluribus\" class=\"img-fluid rounded-4\" style=\"width:100%; aspect-ratio: 16/9; object-fit: cover;\">\n                        <p class=\"mt-2 small fw-semibold\">Pluribus</p>\n                        <span class=\"small text-white-50\">Happiness is a state of mind</span>\n                    </div>\n                </div>\n                <div class=\"col-6 col-md-4 col-lg-3\">\n                    <div class=\"card bg-transparent border-0 text-white\">\n                        <img src=\"https://is1-ssl.mzstatic.com/image/thumb/OmAEHiPsBUBSNjqgm9ItjA/{w}x{h}.{f}\" alt=\"Shrinking\" class=\"img-fluid rounded-4\" style=\"width:100%; aspect-ratio: 16/9; object-fit: cover;\">\n                        <p class=\"mt-2 small fw-semibold\">Shrinking</p>\n                        <span class=\"small text-white-50\">Jason Segel, Harrison Ford</span>\n                    </div>\n                </div>\n                <div class=\"col-6 col-md-4 col-lg-3\">\n                    <div class=\"card bg-transparent border-0 text-white\">\n                        <img src=\"https://is1-ssl.mzstatic.com/image/thumb/810FL_VK0SEREgoMM3eKtA/{w}x{h}.{f}\" alt=\"Hijack\" class=\"img-fluid rounded-4\" style=\"width:100%; aspect-ratio: 16/9; object-fit: cover;\">\n                        <p class=\"mt-2 small fw-semibold\">Hijack</p>\n                        <span class=\"small text-white-50\">Who can you trust?</span>\n                    </div>\n                </div>\n                <div class=\"col-6 col-md-4 col-lg-3\">\n                    <div class=\"card bg-transparent border-0 text-white\">\n                        <img src=\"https://is1-ssl.mzstatic.com/image/thumb/plPQbHn4gzuGfTN4BEEX0Q/{w}x{h}.{f}\" alt=\"Slow Horses\" class=\"img-fluid rounded-4\" style=\"width:100%; aspect-ratio: 16/9; object-fit: cover;\">\n                        <p class=\"mt-2 small fw-semibold\">Slow Horses</p>\n                        <span class=\"small text-white-50\">Emmy Award Winner</span>\n                    </div>\n                </div>\n                <div class=\"col-6 col-md-4 col-lg-3\">\n                    <div class=\"card bg-transparent border-0 text-white\">\n                        <img src=\"https://is1-ssl.mzstatic.com/image/thumb/yLaIuyo68a7gtcjngkHQiQ/{w}x{h}.{f}\" alt=\"Severance\" class=\"img-fluid rounded-4\" style=\"width:100%; aspect-ratio: 16/9; object-fit: cover;\">\n                        <p class=\"mt-2 small fw-semibold\">Severance</p>\n                        <span class=\"small text-white-50\">8 Awards Including Best Actress</span>\n      